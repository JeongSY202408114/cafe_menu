<table border="1">
  <thead><tr><th>ID</th><th>메뉴명</th><th>가격</th><th>카테고리</th></tr></thead>
  <tbody>
    <% menus.forEach((item) => { %>
      <tr><td><%= item.id %></td><td><%= item.name %></td><td><%= item.price %></td><td><%= item.category %></td></tr>
    <% }); %>
    <% if (menus.length === 0) { %>
      <tr><td colspan="3">조회 결과가 없습니다.</td></tr>
    <% } %>
  </tbody>
</table>
